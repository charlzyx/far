{
  "name": "root",
  "version": "0.7.9",
  "description": "Boilerplate for monorepo typescript project",
  "main": "index.js",
  "keywords": [],
  "author": "xiaochao.yang",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "::首次安装依赖": "yarn bootstrap",
    "::!!!不要cd到 packages/* 里面直接安装依赖": "DO NOT CD packages/* run yarn install",
    "::为root项目安装依赖<pkg>": "yarn add -W -D <pkg>",
    "::删除root项目的依赖<pkg>": "yarn remove -W -D <pkg>",
    "::为所有packages/*安装依赖<pkg>": "lerna add <pkg>",
    "::不好用;;删除所有packages/*的依赖<pkg>": "lerna remove <pkg>",
    "::为<pkgB>安装依赖<pkgA>": "yarn workspace <pkgB> add <pkgA>",
    "::删除<pkgB>的依赖<pkgA>": "yarn workspace pkgB remove pkgA",
    "::git commit 请使用下方命令": "yarn commit | npm run commit",
    "::发布": "lerna publish",
    "bootstrap": "yarn install",
    "commit": "git-cz",
    "clean": "lerna clean",
    "build": "lerna run --stream --sort build",
    "start": "lerna run start --parallel",
    "dev": "lerna run dev --parallel",
    "test": "lerna run --stream --sort test"
  },
  "devDependencies": {
    "@commitlint/cli": "^15.0.0",
    "@commitlint/config-conventional": "^15.0.0",
    "@commitlint/config-lerna-scopes": "^15.0.0",
    "@rlx/eslint-config-node": "^2.0.4",
    "@types/node": "^17.0.5",
    "commitizen": "^4.2.4",
    "cz-lerna-changelog": "^2.0.3",
    "husky": "^7.0.4",
    "lerna": "^4.0.0",
    "lint-staged": "^12.1.2",
    "typescript": "^4.5.4"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-lerna-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "@commitlint/config-lerna-scopes"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.(ts|tsx|js|jsx|json)": [
      "eslint --fix",
      "git add"
    ]
  }
}
