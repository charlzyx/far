{
  "compilerOptions": {
    "module": "commonjs",
    "strict": true,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ESNext",
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@rlx/*": [
        "packages/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "importHelpers": false
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
